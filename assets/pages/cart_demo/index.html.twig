{%- extends '@front/layouts/private/layout.html.twig' -%}

{%- set page_show_title = true -%}

{%- block page_title_actions -%}
    {{ button_link('ph:bold/storefront', '@page::shop' | trans, path('shop_index'), { class: 'button--invert' }) }}
    {{ button_link('ph:bold/shopping-cart', '@page::cart' | trans, path('cart_index')) }}
{%- endblock -%}

{%- block page_body -%}
    <p class="lead">{{ '@page::intro' | trans }}</p>
    <h2>{{ '@page::cases.title' | trans }}</h2>
    {{ component(render_pass, '@WexampleSymfonyDesignSystemBundle/components/timeline', {}, { items: [
        { title: '@page::cases.bought.title' | trans, text: '@page::cases.bought.text' | trans, icon: 'ph:bold/check-circle', tone: 'success' },
        { title: '@page::cases.sold_out.title' | trans, text: '@page::cases.sold_out.text' | trans, icon: 'ph:bold/prohibit' },
        { title: '@page::cases.failed.title' | trans, text: '@page::cases.failed.text' | trans, icon: 'ph:bold/x-circle', tone: 'error' },
        { title: '@page::cases.expired.title' | trans, text: '@page::cases.expired.text' | trans, icon: 'ph:bold/clock' },
    ] }) }}
{%- endblock -%}
